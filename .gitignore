# ── Logs ──────────────────────────────────────────────
*.log

# ── .NET ──────────────────────────────────────────────
[Bb]in/
# Отдельный каталог сборки: пока запущен dev-сервер, он держит DLL в bin/, и обычная сборка
# падает на копировании. Собираем в bin-check/ — это тот же мусор сборки, только под другим именем.
bin-check/
# То же и для запуска (`dotnet run -p:BaseOutputPath=bin-run/`), когда :5000 занят своим
# экземпляром: без этой строки артефакты уезжают в коммит — 213 файлов за один `git add`.
bin-run/
[Oo]bj/
*.user
.vs/

# ── Node / Vite ───────────────────────────────────────
node_modules/
dist/
*.local

# ── Test / coverage artifacts ─────────────────────────
coverage/
TestResults/

# ── Сохранённый вывод запущенного сервера ─────────────
# Репозиторий публичный, а в логе видны схема БД и запросы EF — коммитить его незачем.
src/server/api_out*.txt

# ── Deploy secrets ────────────────────────────────────
deploy/.env

# ── Отчёты аудита безопасности ────────────────────────
# Репозиторий публичный: описания уязвимостей не коммитим и не выносим в issue.
# В issue уходит только ссылка на локальный файл и номер раздела.
docs/security/

# ── Editors / OS ──────────────────────────────────────
.idea/
.DS_Store
Thumbs.db

# ── Local tooling config ──────────────────────────────
.claude/

# Data Protection keys (issue #148) — секрет, не коммитить
src/server/BHS.CRG.Api/dp-keys/
dp-keys/

# Agent sync artifacts
.design-sync/
.ds-sync/
.ds-css/
.ds-entry.tsx
ds-bundle/
