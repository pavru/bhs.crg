<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    Модуль «Планирование» — третий модуль решения (этап 3, change plan-01-skeleton, ТЗ CORE-1,
    PLAN-1). Устроен как `costs`, и по тем же причинам (подробно — в BHS.CRG.Modules.Costs.csproj):

    ⚠️ Ссылки только на контракты ядра и на домен. Ни Application, ни Infrastructure, ни другой
    модуль — ни даже `costs`, хотя заявки на закупку будут читать сметы: межмодульное идёт
    контрактом ядра (CORE-34), а не ссылкой. Стережёт ModuleBoundaryTests.

    FrameworkReference — модуль регистрирует службы и адреса.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!--
    Провайдер базы — свой, как у `costs`: схема `plan`, свой набор миграций. Версии — те же, что в
    инфраструктуре ядра и у `costs`: два провайдера разных версий в одном процессе разошлись бы на
    первом различии в генерации SQL. EF Design — ради `dotnet ef migrations add` (PlanDbContextFactory),
    в поставку не едет.
  -->
  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    Своя редакция схем ГРАНД-Сметы (plan-05): разбор проверяет файл по ним, а поставляются они ресурсом
    сборки — рядом с кодом, который их читает. Имя ресурса — без пространства имён проекта, его ищет
    GrandSmetaSchemas.Load.
  -->
  <ItemGroup>
    <EmbeddedResource Include="GrandSmeta\Schemas\*.xsd" LogicalName="GrandSmeta.Schemas.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Домен — ради общего языка отказов решения (ConflictException и соседи), как у `costs`. -->
  <ItemGroup>
    <ProjectReference Include="..\BHS.CRG.Modules\BHS.CRG.Modules.csproj" />
    <ProjectReference Include="..\BHS.CRG.Domain\BHS.CRG.Domain.csproj" />
  </ItemGroup>

</Project>
