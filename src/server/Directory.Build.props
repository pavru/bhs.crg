<Project>
  <!-- Единая версия продукта (SemVer, префикс-ноль до первого боевого релиза). Bump MINOR — набор
       функциональности, PATCH — фиксы; 1.0.0 — первый релиз. К InformationalVersion SDK добавляет
       +<git-sha> (см. target ниже) для трассировки сборок на внутреннем тестировании. -->
  <PropertyGroup>
    <Version>0.120.1</Version>
  </PropertyGroup>

  <!-- Доменные отказы (BHS.CRG.Domain.Common) доступны без using во всех проектах, кроме
       BHS.CRG.Plugins: контракт плагинов намеренно не зависит ни от чего своего — плагин
       собирается сторонним разработчиком, и тянуть в него доменную сборку значит навязывать её
       версию. Если появится ещё один проект без ссылки на Domain, сборка встанет здесь же.

       Общий using, а не строка в каждом файле: бросают эти типы под сотню мест, а имя
       `NotFoundException` без пространства имён однозначно. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'BHS.CRG.Plugins'">
    <Using Include="BHS.CRG.Domain.Common" />
  </ItemGroup>

  <!-- Известная уязвимость ВЫСОКОЙ или критической серьёзности в зависимости останавливает сборку
       (NU1903/NU1904). Низкие и средние остаются предупреждениями.

       Так сделано потому, что предупреждениями это уже было: восемь NU1903 печатались при каждой
       сборке и каждом прогоне тестов месяцами, и их перестали замечать — а следующее, уже про
       что-то важное, утонуло бы там же. Порог по серьёзности выбран, чтобы остановка была редким
       и осмысленным событием.

       Если сборка встала на новой рекомендации: поднять версию пакета, а когда исправленной версии
       ещё нет — временно добавить код в NoWarn ЗДЕСЬ ЖЕ, с комментарием и датой, чтобы исключение
       было видно всем, а не жило в чьей-то локальной настройке. -->
  <PropertyGroup>
    <WarningsAsErrors>$(WarningsAsErrors);NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>

  <!-- Проставляем короткий git-хеш в SourceRevisionId, если он ещё не задан — SDK допишет его в
       InformationalVersion как "0.1.0+<sha>". ContinueOnError — сборка вне git-репозитория не падает. -->
  <Target Name="SetGitCommitId" BeforeTargets="AddSourceRevisionToInformationalVersion"
          Condition="'$(SourceRevisionId)' == ''">
    <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" ContinueOnError="true"
          WorkingDirectory="$(MSBuildThisFileDirectory)" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="SourceRevisionId" />
    </Exec>
  </Target>
</Project>
