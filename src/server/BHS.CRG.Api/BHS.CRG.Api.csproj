<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>23757ad1-5576-482e-a16b-797d8d9ae735</UserSecretsId>
  </PropertyGroup>

  <!--
    Конфигурация среды разработки в поставку НЕ идёт. Значения в ней рассчитаны на локальную машину
    и лежат в репозитории — то есть известны публично; в опубликованном виде их быть не должно.

    Без этой строки файл попадал в образ, и `ASPNETCORE_ENVIRONMENT=Development`, выставленный на
    боевом контейнере (обычное действие при разборе неполадки), поднимал приложение на значениях из
    репозитория вместо заданных развёртыванием — включая ключ подписи токенов.

    По умолчанию SDK кладёт все appsettings*.json и в вывод сборки, и в публикацию: убираем только
    из публикации, локальный запуск продолжает читать файл из bin.
  -->
  <ItemGroup>
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.4.1" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />

    <!-- Кодом не используется: Microsoft.AspNetCore.OpenApi тянет его за собой, а версия из его
         зависимостей (2.0.0) числится в известных уязвимостях (NU1903, разбор схемы с круговыми
         ссылками). Прямая ссылка поднимает разрешённую версию до исправленной, оставаясь в той же
         старшей версии 2.x, на которую рассчитан AspNetCore.OpenApi. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BHS.CRG.Application\BHS.CRG.Application.csproj" />
    <ProjectReference Include="..\BHS.CRG.Infrastructure\BHS.CRG.Infrastructure.csproj" />
  </ItemGroup>

</Project>
