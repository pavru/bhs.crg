<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    Проект КОНТРАКТОВ ядра: на него ссылаются модули, и больше в нём ничего нет.

    ⚠️ Ссылок на другие наши проекты здесь нет и быть не должно (issue #942, ТЗ CORE-2). Ссылка
    отсюда на Application или Infrastructure открыла бы модулю весь слой доступа к данным — а
    ограничение «модуль знает ядро, ядро о модуле не знает» держится именно на том, что через этот
    проект нечего протащить. Стережёт ModuleBoundaryTests: он читает ЭТОТ файл и падает на любой
    строке ProjectReference.

    FrameworkReference нужен потому, что модуль регистрирует службы и адреса: без
    IServiceCollection и IEndpointRouteBuilder интерфейс модуля не выразить.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!--
    EF Core — ради ModuleDbContext (задача A2a этапа 2, issue #1072): у модуля своя схема базы, свой
    набор миграций и своя история, и базовый контекст даёт ему схему по умолчанию и защиту
    дописываемых наборов от правки.

    ⚠️ Это ПАКЕТ, а не ссылка на наш проект, и разница здесь принципиальная. Запрет «ни одной
    ProjectReference» стоит против транзитивности: ссылка на Application или Infrastructure открыла бы
    модулю слой доступа к данным ЯДРА — его таблицы, его репозитории, его контекст. Пакет EF ничего
    нашего не открывает: он даёт умение работать со СВОЕЙ схемой, и ровно этого CORE-4 от модуля и
    требует. Правило не ослаблено — ModuleBoundaryTests читает этот файл и продолжает падать на любой
    строке ProjectReference.

    Альтернатива, от которой отказались: оставить каждому модулю писать свой контекст с нуля. Тогда
    защита дописываемых наборов и схема по умолчанию оказались бы обязанностью, которую выполняют те
    модули, которые о ней вспомнили, — а забытая защита выглядит как работающая.

    Барьер здесь архитектурный, а не технический, и сказать это надо вслух: модуль и без EF получает
    строку подключения из настроек, то есть может открыть соединение к той же базе и прочитать чужую
    схему. Держат границу правило, ревью и сторожа — не невозможность.

    Relational, а не Microsoft.EntityFrameworkCore: схема по умолчанию (HasDefaultSchema) — понятие
    реляционной базы, и без этого пакета выразить «таблицы модуля лежат в его схеме» нечем. Провайдер
    (Npgsql) объявляет у себя КАЖДЫЙ модуль: провайдер — часть его поставки, а не контракта ядра.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.9" />
  </ItemGroup>

</Project>
