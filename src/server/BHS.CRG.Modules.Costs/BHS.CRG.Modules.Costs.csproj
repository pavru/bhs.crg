<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    Модуль «Счета и накладные» — ПЕРВЫЙ настоящий модуль решения (ТЗ COST-Q1, CORE-1).

    ⚠️ Ссылки только на контракты ядра (и, когда понадобится, на домен). Ни Application, ни
    Infrastructure, ни другой модуль: ссылки транзитивны, и любая из них открыла бы модулю слой
    доступа к данным целиком. Стережёт ModuleBoundaryTests — он опознаёт модуль по ссылке на
    контракты, а не по имени каталога, и требует имени «BHS.CRG.Modules.<код>».

    Отсюда и цена, принятая вслух решением владельца 28.09.2026 (нарезка этапа 2, п. 8): всё, что
    модулю нужно от ядра — блобы, журнал, уведомления, задачи, права, справочники, — приходит
    ПОРТАМИ в проекте контрактов (задача M2, issue #1069). Сегодня портов к данным там ноль, и это
    не обходится ссылкой: обойти правило значит отменить его.

    FrameworkReference — потому что модуль регистрирует службы и адреса: без IServiceCollection и
    IEndpointRouteBuilder интерфейс модуля не выразить. Транзитивности контрактов здесь не доверяем
    намеренно — объявление рядом с кодом, который от него зависит.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!--
    Домен — второе и последнее, что модулю разрешено (ModuleBoundaryTests). Ссылка нужна с первого
    дня, хотя доменных типов модуль пока не трогает: общий `global using BHS.CRG.Domain.Common` из
    Directory.Build.props стоит у КАЖДОГО проекта решения, кроме контрактов модулей и контракта
    плагинов, — и без ссылки проект не собирается вовсе. Это не случайность сборки, а решение:
    доменные отказы (NotFoundException и соседи) — общий язык ошибок всего решения, по нему
    выстроено сопоставление ответов API, и модуль от него не освобождён.

    Разобраться было можно и иначе — добавить `costs` в исключение Directory.Build.props, — но тогда
    модуль стал бы третьим проектом с ДРУГИМ языком отказов, и первая же его команда отвечала бы
    заказчику не тем кодом, что ядро. Условие в props оставлено для тех двух, кому оно нужно по
    существу: контракт плагинов собирает сторонний разработчик, а контракт модулей обязан остаться
    минимальным.
  -->
  <!--
    Провайдер базы — у модуля свой (задача A2a этапа 2, issue #1072): схема `costs`, свой набор
    миграций, своя история. Контракты ядра дают только EF Core без провайдера — провайдер часть
    ПОСТАВКИ модуля, и объявляет его тот, кто эти миграции пишет.

    EF Design нужен ради `dotnet ef migrations add` (см. CostsDbContextFactory) и в поставку не
    едет — PrivateAssets=all. Версии те же, что в инфраструктуре ядра: два провайдера разных версий
    в одном процессе разошлись бы на первом же различии в генерации SQL.
  -->
  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BHS.CRG.Modules\BHS.CRG.Modules.csproj" />
    <ProjectReference Include="..\BHS.CRG.Domain\BHS.CRG.Domain.csproj" />
  </ItemGroup>

</Project>
