<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    Модуль «Учёт работ» — четвёртый модуль решения (этап 4, change work-10-skeleton, ТЗ CORE-1,
    WORK-1). Устроен как `costs` и `plan`, и по тем же причинам (подробно — в BHS.CRG.Modules.Costs.csproj):

    ⚠️ Ссылки только на контракты ядра и на домен. Ни Application, ни Infrastructure, ни другой
    модуль — ни даже `plan`, хотя строка отчёта находит позицию перечня, а «по смете — фактически»
    читает нормы сметы: межмодульное идёт контрактом ядра (CORE-34), а не ссылкой. Стережёт
    ModuleBoundaryTests.

    FrameworkReference — модуль регистрирует службы и адреса.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!--
    Провайдер базы — свой, как у `costs` и `plan`: схема `work`, свой набор миграций. Версии — те же, что
    в инфраструктуре ядра и у соседей: два провайдера разных версий в одном процессе разошлись бы на
    первом различии в генерации SQL. EF Design — ради `dotnet ef migrations add` (WorkDbContextFactory),
    в поставку не едет.
  -->
  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Домен — ради общего языка отказов решения (ConflictException и соседи), как у `costs` и `plan`. -->
  <ItemGroup>
    <ProjectReference Include="..\BHS.CRG.Modules\BHS.CRG.Modules.csproj" />
    <ProjectReference Include="..\BHS.CRG.Domain\BHS.CRG.Domain.csproj" />
  </ItemGroup>

</Project>
