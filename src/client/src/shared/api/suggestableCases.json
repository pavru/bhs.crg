{
  "about": "Подсказывается ли поле значениями, введёнными ранее, — общий набор случаев (issue #1529). Его считают оба: сервер (SuggestableCasesTests, Suggestable.Reason) и клиент (suggestable.test.ts, suggestReason). Разойдутся правила — краснеет тот, кто отстал. field — поле схемы (type, computed, locked, tags как в схеме, с номером или без); expect — код причины, «suggested» — подсказывается. Порядок проверок: type → computed → locked → тэги однозначности (в порядке перечня) → manual.",
  "cases": [
    { "name": "обычная строка подсказывается",
      "field": { "type": "string", "computed": false, "locked": false, "tags": [] }, "expect": "suggested" },
    { "name": "строка с тэгом без влияния подсказывается",
      "field": { "type": "string", "computed": false, "locked": false, "tags": ["employee.position"] }, "expect": "suggested" },
    { "name": "многострочный текст — не тот вид",
      "field": { "type": "text", "computed": false, "locked": false, "tags": [] }, "expect": "type" },
    { "name": "пользовательский вид — не тот вид",
      "field": { "type": "primitive", "computed": false, "locked": false, "tags": [] }, "expect": "type" },
    { "name": "флажок — не тот вид",
      "field": { "type": "boolean", "computed": false, "locked": false, "tags": ["work.producesId"] }, "expect": "type" },
    { "name": "вычисляемое поле",
      "field": { "type": "string", "computed": true, "locked": false, "tags": [] }, "expect": "computed" },
    { "name": "запертое поле",
      "field": { "type": "string", "computed": false, "locked": true, "tags": [] }, "expect": "locked" },
    { "name": "идентификатор с номером компонента",
      "field": { "type": "string", "computed": false, "locked": false, "tags": ["identity:2"] }, "expect": "identity" },
    { "name": "ИНН",
      "field": { "type": "string", "computed": false, "locked": false, "tags": ["org.inn"] }, "expect": "inn" },
    { "name": "номер документа",
      "field": { "type": "string", "computed": false, "locked": false, "tags": ["doc.number"] }, "expect": "docNumber" },
    { "name": "табельный номер",
      "field": { "type": "string", "computed": false, "locked": false, "tags": ["employee.personnelNumber"] }, "expect": "personnelNumber" },
    { "name": "артикул позиции",
      "field": { "type": "string", "computed": false, "locked": false, "tags": ["nomenclature.article"] }, "expect": "article" },
    { "name": "название организации",
      "field": { "type": "string", "computed": false, "locked": false, "tags": ["org.name"] }, "expect": "orgName" },
    { "name": "выключено вручную",
      "field": { "type": "string", "computed": false, "locked": false, "tags": ["input.noSuggest"] }, "expect": "manual" },
    { "name": "порядок: однозначность раньше ручного выключения",
      "field": { "type": "string", "computed": false, "locked": false, "tags": ["input.noSuggest", "identity"] }, "expect": "identity" },
    { "name": "порядок: тэги однозначности — в порядке перечня, а не поля",
      "field": { "type": "string", "computed": false, "locked": false, "tags": ["employee.personnelNumber", "identity:1"] }, "expect": "identity" },
    { "name": "порядок: запертое раньше тэга однозначности",
      "field": { "type": "string", "computed": false, "locked": true, "tags": ["org.inn"] }, "expect": "locked" },
    { "name": "порядок: вычисляемое раньше запертого",
      "field": { "type": "string", "computed": true, "locked": true, "tags": [] }, "expect": "computed" },
    { "name": "порядок: вид раньше всего — ручное выключение на тексте не сработало бы",
      "field": { "type": "text", "computed": true, "locked": true, "tags": ["input.noSuggest"] }, "expect": "type" }
  ]
}
