{
  "about": "Правило сверки названий в колонке-перечне — общий набор случаев (UI-56, change costs-filter-place-hints). Его считают оба: клиент (conditionMatch.test.ts, listMatches — пометка «нет в справочнике») и сервер (ConditionMatchCasesTests, TableConditions.Matches с видом list). Разойдутся — краснеет тот, кто отстал. items — названия в клетке, expect — подходит ли клетка под условие.",
  "cases": [
    { "name": "равно: регистр не важен", "op": "eq", "values": ["комарова 36"], "items": ["Комарова 36"], "expect": true },
    { "name": "равно: ё и е различаются", "op": "eq", "values": ["Березовая 4"], "items": ["Берёзовая 4"], "expect": false },
    { "name": "равно: хвостовой пробел значим", "op": "eq", "values": ["Комарова 36 "], "items": ["Комарова 36"], "expect": false },
    { "name": "равно: строка целиком, а не начало", "op": "eq", "values": ["Комарова 36"], "items": ["Комарова 36А"], "expect": false },
    { "name": "равно: хоть один элемент перечня", "op": "eq", "values": ["Склад"], "items": ["Комарова 36", "Склад"], "expect": true },
    { "name": "не равно: перечень без значения подходит", "op": "neq", "values": ["Ленина 5"], "items": ["Комарова 36"], "expect": true },
    { "name": "не равно: ни одного такого — перечень с ним не подходит", "op": "neq", "values": ["Склад"], "items": ["Комарова 36", "Склад"], "expect": false },
    { "name": "из списка: любое из значений", "op": "in", "values": ["Ленина 5", "КОМАРОВА 36"], "items": ["Комарова 36"], "expect": true },
    { "name": "не из списка: ни одного из значений", "op": "not_in", "values": ["Ленина 5"], "items": ["Комарова 36"], "expect": true },
    { "name": "содержит: часть названия без регистра", "op": "contains", "values": ["марова"], "items": ["Комарова 36"], "expect": true },
    { "name": "содержит: ё и е различаются", "op": "contains", "values": ["берез"], "items": ["Берёзовая 4"], "expect": false },
    { "name": "не содержит: ни один элемент не содержит", "op": "not_contains", "values": ["Ленина"], "items": ["Комарова 36"], "expect": true },
    { "name": "начинается с: раздел стройки с косой чертой", "op": "starts_with", "values": ["Комарова 36 /"], "items": ["Комарова 36 / 4 эт."], "expect": true },
    { "name": "начинается с: косая черта отсекает соседнюю стройку", "op": "starts_with", "values": ["Комарова 36 /"], "items": ["Комарова 36А / 4 эт."], "expect": false },
    { "name": "заканчивается на", "op": "ends_with", "values": ["без раздела"], "items": ["Комарова 36 / без раздела"], "expect": true },
    { "name": "пусто: перечня нет", "op": "is_empty", "values": [], "items": [], "expect": true },
    { "name": "не пусто: перечень есть", "op": "is_not_empty", "values": [], "items": ["Склад"], "expect": true }
  ]
}
