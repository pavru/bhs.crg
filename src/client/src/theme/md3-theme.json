{
  "//": [
    "Описание темы MD3 (эпик sharedui-md3, [UI-57] [UI-62]). Единственный источник цвета клиента: из него",
    "`npm run md3:theme` пишет md3-tokens.css, md3-tailwind.css и md3-legacy.css — руками их не правят.",
    "mode \"seed\" — значения ролей обеих тем считает генератор схемы MCU из seed по варианту схемы",
    "(решение владельца 29.10.2026: tonalSpot, primary закреплён равным seed, свои роли без гармонизации).",
    "Ручных значений ролей нет: цвет меняют seed, variant, pinPrimary и ext. Контраст пар — тест темы.",
    "aliases — старые имена классов: имя роли или { legacy } — значение без роли MD3.",
    "Растить их нельзя (храповик legacy-class); снимает финал эпика."
  ],
  "mode": "seed",
  "seed": "#1d5fb0",
  "variant": "tonalSpot",
  "contrast": 0,
  "pinPrimary": true,
  "typeface": {
    "plain": "'Roboto', system-ui, -apple-system, 'Segoe UI', sans-serif"
  },
  "ext": [
    { "name": "success", "value": "#1b8a5b", "harmonize": false },
    { "name": "warning", "value": "#7a5900", "harmonize": false }
  ],
  "static": {
    "//": "Половины превью значка вкладки (issue #1315): с темой не переключаются — вкладка браузера теме приложения не следует. Значение — ссылка «тема.роль»: превью совпадает с фоном страницы своей темы и после смены палитры.",
    "tab-light": "light.surface-container-low",
    "tab-dark": "dark.surface-container-low"
  },
  "elevation": {
    "light": {
      "level1": "0 1px 2px rgba(16,35,63,.30), 0 1px 3px 1px rgba(16,35,63,.12)",
      "level2": "0 2px 8px rgba(16,35,63,.12), 0 1px 2px rgba(16,35,63,.10)",
      "level3": "0 8px 24px rgba(0,0,0,.28), 0 2px 6px rgba(0,0,0,.14)"
    },
    "dark": {
      "level1": "0 1px 2px rgba(0,0,0,.40), 0 1px 3px 1px rgba(0,0,0,.24)",
      "level2": "0 2px 8px rgba(0,0,0,.36), 0 1px 2px rgba(0,0,0,.24)",
      "level3": "0 8px 24px rgba(0,0,0,.48), 0 2px 6px rgba(0,0,0,.28)"
    }
  },
  "aliases": {
    "fg1": "on-surface",
    "fg2": "on-surface-variant",
    "fg3": "on-surface-variant",
    "fg4": "on-surface-variant",
    "fg-disabled": { "legacy": { "light": "#a3a5ab", "dark": "#5c5f66" } },
    "base": "surface-container-low",
    "muted": "surface-container",
    "muted-hover": "surface-container-high",
    "stroke": "outline-variant",
    "stroke-strong": "outline",
    "stroke-subtle": { "legacy": { "light": "#e3e1e6", "dark": "#282a2f" } },
    "brand": "primary",
    "brand-hover": { "legacy": { "light": "#17518f", "dark": "#bcd4ff" } },
    "brand-pressed": { "legacy": { "light": "#124074", "dark": "#8bb3f0" } },
    "brand-subtle": "primary-container",
    "on-brand": "on-primary",
    "on-brand-subtle": "on-primary-container",
    "tonal": "secondary-container",
    "on-tonal": "on-secondary-container",
    "tertiary-subtle": "tertiary-container",
    "on-tertiary-subtle": "on-tertiary-container",
    "success-subtle": "success-container",
    "warning-subtle": "warning-container",
    "warning-border": { "legacy": { "light": "#c49500", "dark": "#5a3c00" } },
    "danger": "error",
    "danger-subtle": "error-container",
    "on-danger": "on-error"
  }
}
