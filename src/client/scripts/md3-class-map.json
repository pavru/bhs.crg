{
  "//": [
    "Карта перевода старых имён на роли MD3 (эпик sharedui-md3, [UI-58]): по ней npm run md3:migrate",
    "переводит классы, переменные и var(--color-…) во всех строках src/. Однопроходная: результат замены",
    "повторно не заменяется. Общая для эпика — дети 03–07 дописывают свои строки.",
    "names — имя цвета для любой цветовой утилиты; same: true — «вид не меняется», это сверяет",
    "md3-migrate.test.mjs в обеих темах. var(--color-<имя>) переводится по той же таблице.",
    "classes — полный класс (без варианта и прозрачности); перекрывает names. to — замена, skip — не",
    "трогать и назвать отчётом (причина — значение).",
    "vars — переменная целиком. Старое имя из aliases описания темы, которого нет в names, —",
    "неоднозначно: команда его не трогает и называет отчётом, как и --f-* без строки здесь."
  ],
  "names": {
    "fg1": { "to": "on-surface", "same": true },
    "fg2": { "to": "on-surface-variant", "same": true },
    "fg4": { "to": "outline", "same": true },
    "base": { "to": "surface-container-low", "same": true },
    "muted": { "to": "surface-container", "same": true },
    "muted-hover": { "to": "surface-container-high", "same": true },
    "stroke": { "to": "outline-variant", "same": true },
    "stroke-strong": { "to": "outline", "same": true },
    "brand": { "to": "primary", "same": true },
    "brand-subtle": { "to": "primary-container", "same": true },
    "on-brand": { "to": "on-primary", "same": true },
    "on-brand-subtle": { "to": "on-primary-container", "same": true },
    "tonal": { "to": "secondary-container", "same": true },
    "on-tonal": { "to": "on-secondary-container", "same": true },
    "tertiary-subtle": { "to": "tertiary-container", "same": true },
    "on-tertiary-subtle": { "to": "on-tertiary-container", "same": true },
    "success-subtle": { "to": "success-container", "same": true },
    "warning-subtle": { "to": "warning-container", "same": true },
    "danger": { "to": "error", "same": true },
    "danger-subtle": { "to": "error-container", "same": true },
    "on-danger": { "to": "on-error", "same": true }
  },
  "classes": {
    "text-base": { "skip": "размер текста, а не цвет" },
    "text-fg4": { "skip": "текст цветом обводки: по MD3 это on-surface-variant, смена вида (sharedui-md3-04)" },
    "text-stroke-strong": { "skip": "обводка цветом текста: по MD3 текст — on-surface-variant, это смена вида (sharedui-md3-04)" }
  },
  "vars": {
    "--f-shadow4": "--md-sys-elevation-level1",
    "--f-shadow16": "--md-sys-elevation-level2",
    "--f-shadow28": "--md-sys-elevation-level3",
    "--f-font": "--md-ref-typeface-plain",
    "--f-bg1": "--md-sys-color-surface",
    "--f-bg2": "--md-sys-color-surface-container-low",
    "--f-bg3": "--md-sys-color-surface-container",
    "--f-bg4": "--md-sys-color-surface-container-high",
    "--f-tab-light": "--md-ext-color-tab-light",
    "--f-tab-dark": "--md-ext-color-tab-dark",
    "--f-fg1": "--md-sys-color-on-surface",
    "--f-fg2": "--md-sys-color-on-surface-variant",
    "--f-stroke1": "--md-sys-color-outline",
    "--f-stroke2": "--md-sys-color-outline-variant",
    "--f-brand": "--md-sys-color-primary",
    "--f-brand-fg": "--md-sys-color-primary",
    "--f-brand-bg2": "--md-sys-color-primary-container",
    "--f-brand-text": "--md-sys-color-on-primary",
    "--f-on-primary-container": "--md-sys-color-on-primary-container",
    "--f-secondary-container": "--md-sys-color-secondary-container",
    "--f-on-secondary-container": "--md-sys-color-on-secondary-container",
    "--f-tertiary": "--md-sys-color-tertiary",
    "--f-tertiary-container": "--md-sys-color-tertiary-container",
    "--f-on-tertiary-container": "--md-sys-color-on-tertiary-container",
    "--f-success-fg": "--md-ext-color-success",
    "--f-success-bg": "--md-ext-color-success-container",
    "--f-success-text": "--md-ext-color-on-success",
    "--f-warning-fg": "--md-ext-color-warning",
    "--f-warning-bg": "--md-ext-color-warning-container",
    "--f-warning-text": "--md-ext-color-on-warning",
    "--f-danger-fg": "--md-sys-color-error",
    "--f-danger-bg": "--md-sys-color-error-container",
    "--f-danger-text": "--md-sys-color-on-error"
  }
}
