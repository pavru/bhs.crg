{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:ratchet": "node scripts/lint-ratchet.mjs",
    "lint:ratchet:update": "node scripts/lint-ratchet.mjs --update",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:keyboard": "node e2e/keyboard-smoke.mjs",
    "test:e2e:routing": "node e2e/routing-smoke.mjs",
    "test:e2e:fields": "node e2e/fields-smoke.mjs",
    "test:e2e:dialogs": "node e2e/dialogs-smoke.mjs"
  },
  "//engines": "Нижнюю границу Node задаёт react-router 8 (>=22.22.0). Соблюдение обеспечивает engine-strict в .npmrc: ниже порога npm ci падает с EBADENGINE. Образ сборки — node:22-alpine, см. deploy/Dockerfile.web.",
  "engines": {
    "node": ">=22.22.0"
  },
  "//overrides": "monaco-editor закрепляет dompurify ровно на 3.4.8, а в версиях до 3.4.11 включительно числятся обходы очистки разметки. Своей версии monaco без них пока нет, поэтому поднимаем зависимость сами: 3.4.x — исправительные выпуски, разметку Monaco чистит только в подсказках. Снять, когда monaco перейдёт на 3.4.12+.",
  "overrides": {
    "dompurify": "3.4.13"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.2.10",
    "@fontsource/roboto-mono": "^5.2.9",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-popover": "^1.1.18",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-toast": "^1.2.17",
    "@tanstack/react-query": "^5.101.0",
    "axios": "^1.18.0",
    "clsx": "^2.1.1",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^1.21.0",
    "monaco-editor": "0.56.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.3.0",
    "tailwind-merge": "^3.6.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.9"
  }
}
