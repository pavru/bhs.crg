# syntax=docker/dockerfile:1
# ── Сборка SPA ──────────────────────────────────────────────────────────────────
# Тег плавающий и сейчас даёт 22.23; ниже 22.22 опускаться нельзя — столько требует
# react-router 8. Требование не на честном слове: .npmrc включает engine-strict, и на
# Node ниже порога `npm ci` падает с EBADENGINE, а не собирает образ втихую (проверено
# на node:22.20-alpine). Поэтому .npmrc копируется рядом с манифестами.
FROM node:22-alpine AS build
WORKDIR /app
COPY src/client/package.json src/client/package-lock.json src/client/.npmrc ./
RUN npm ci
COPY src/client ./
RUN npm run build

# ── Раздача через nginx ─────────────────────────────────────────────────────────
# Непривилегированная сборка nginx: процесс работает от пользователя nginx, а не от root.
# Отсюда и внутренний порт 8080 вместо 80 — непривилегированный процесс не занимает порты < 1024
# (снаружи порт прежний, см. WEB_PORT в docker-compose.yml).
FROM nginxinc/nginx-unprivileged:alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
