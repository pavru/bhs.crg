# syntax=docker/dockerfile:1
# ── Сборка SPA ──────────────────────────────────────────────────────────────────
FROM node:22-alpine AS build
WORKDIR /app
COPY src/client/package.json src/client/package-lock.json ./
RUN npm ci
COPY src/client ./
RUN npm run build

# ── Раздача через nginx ─────────────────────────────────────────────────────────
# Непривилегированная сборка nginx: процесс работает от пользователя nginx, а не от root.
# Отсюда и внутренний порт 8080 вместо 80 — непривилегированный процесс не занимает порты < 1024
# (снаружи порт прежний, см. WEB_PORT в docker-compose.yml).
FROM nginxinc/nginx-unprivileged:alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
