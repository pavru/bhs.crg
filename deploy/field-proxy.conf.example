# Отдельный публичный виртуальный хост монтажников (MOB-13).
# На хосте nginx замените имя и порт web, затем настройте TLS по приложению В
# docs/DEPLOYMENT.md. Прямой порт web доступен только доверенной сети.
server {
    listen 80;
    server_name field.example.ru;
    server_tokens off;
    client_max_body_size 600m;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;

    location ^~ /api/field/ {
        proxy_pass http://127.0.0.1:8080/api/field/;
    }
    location ^~ /m/ {
        proxy_pass http://127.0.0.1:8080/m/;
    }
    location / {
        return 404;
    }
}
