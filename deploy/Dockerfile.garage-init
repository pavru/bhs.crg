# Образ одноразовой инициализации Garage (issue #885): «alpine + бинарь Garage».
#
# Зачем он нужен. В официальном образе Garage нет shell — там один исполняемый файл, — а
# инициализация это последовательность из четырёх команд, которая обязана быть идемпотентной
# (compose поднимает её при каждом старте стека). Написать такую последовательность нечем.
#
# Бинарь берётся ИЗ ТОГО ЖЕ образа, что и сервер, — копией, а не отдельной загрузкой: клиент и
# сервер Garage должны быть одной версии, а второй источник (скачивание с сайта проекта) означал
# бы, что они расходятся молча. Версия ниже прибита точно и сверяется с compose проверкой в CI —
# ровно потому, что теперь она записана в ДВУХ местах.
FROM dxflrs/garage:v2.3.0 AS garage
FROM alpine:3.24.1

COPY --from=garage /garage /usr/local/bin/garage
COPY garage-init.sh /usr/local/bin/garage-init
RUN chmod +x /usr/local/bin/garage-init

ENTRYPOINT ["/usr/local/bin/garage-init"]
