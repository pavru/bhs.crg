# ── Скопируйте в .env и заполните значения ──────────────────────────────────────
# cp deploy/.env.example deploy/.env

# Версия системы: под этим тегом тянутся образы api и web из GHCR (issue #812). Список выпусков —
# https://github.com/pavru/bhs.crg/releases. Обновление = поменять номер здесь, затем
#   docker compose -f deploy/docker-compose.yml pull && docker compose -f deploy/docker-compose.yml up -d
# Резервную копию делайте ДО обновления: схема базы мигрирует при старте, отката миграций нет.
# `latest` здесь намеренно не годится: по нему нельзя ни сказать, что крутится на хосте, ни
# вернуться на прошлую версию.
#
# В шаблоне значение ПУСТОЕ, и это не пропуск: номер живёт в одном месте — Directory.Build.props, —
# а сюда его подставляет workflow выпуска, когда прикладывает файл к релизу. Храни репозиторий
# конкретный номер, он расходился бы с выпуском на следующем же релизе. Ставите вручную — берите
# номер со страницы выпусков.
APP_VERSION=

# PostgreSQL
POSTGRES_DB=bhs_crg
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_password

# ── Garage (объектное хранилище) ────────────────────────────────────────────────
# Это учётные данные доступа ко ВСЕМ файлам системы. Значения ниже — заглушки; при обновлении с
# версий до 0.160.0 `update.sh` генерирует настоящие сам и вписывает их в .env, придумывать
# ничего не нужно. Ставите с нуля — сгенерируйте:
#
#   GARAGE_KEY_ID:     echo "GK$(openssl rand -hex 12)"
#   GARAGE_SECRET:     openssl rand -hex 32
#   GARAGE_RPC_SECRET: openssl rand -hex 32
#   GARAGE_ADMIN_TOKEN: openssl rand -base64 32
#
# ФОРМАТ КЛЮЧА ЖЁСТКИЙ: идентификатор — «GK» и 24 шестнадцатеричных знака, секрет — ровно 64
# шестнадцатеричных знака, RPC-секрет — тоже 64. Значение другой длины Garage отвергает при
# старте («Invalid RPC secret key: expected 32 bytes of random hex»), то есть хранилище просто
# не поднимется.
# ⚠️ Заглушки НАЧИНАЮТСЯ с «change_me» намеренно: проверка при старте узнаёт невыправленное
# значение по началу строки. Похожий на настоящий «GK0000…change_me» она пропустила бы — и
# установка поехала бы с ключом из примера, то есть с открытой дверью.
GARAGE_KEY_ID=change_me_see_comment_above
GARAGE_SECRET=change_me_64_hex_characters_see_comment_above
GARAGE_RPC_SECRET=change_me_64_hex_characters_see_comment_above
GARAGE_ADMIN_TOKEN=change_me_admin_token
GARAGE_BUCKET=bhs-crg
# Веб-консоли у Garage нет — в отличие от MinIO, у которого она публиковалась на петлю. Управление
# идёт CLI внутри контейнера (см. §6 инструкции по развёртыванию), наружу не публикуется ничего.

# JWT — длинный случайный секрет (минимум 32 символа!)
# Сгенерировать:  openssl rand -base64 48
# Значение ниже — заглушка: приложение с ней НЕ ЗАПУСТИТСЯ, это проверяется при старте.
JWT_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# Веб-интерфейс (порт на хосте)
WEB_PORT=8080
# Адрес, на котором публикуется веб-интерфейс. По умолчанию все интерфейсы — без обратного прокси
# иначе к системе не подключиться. Поставили перед ней прокси с TLS (Приложение В в инструкции по
# развёртыванию) — поставьте здесь 127.0.0.1: тогда порт выше отвечает только самому серверу, то
# есть прокси, и войти в обход HTTPS нельзя.
WEB_BIND=0.0.0.0

# Сети, чьему заголовку X-Forwarded-For сервер доверяет (CIDR через запятую). Из этого заголовка
# берётся адрес клиента для пределов частоты обращений. Пусто — петля и частные диапазоны, чего
# достаточно, пока API доступен только из сети Compose. Сузьте до сети своего обратного прокси,
# если API виден откуда-то ещё. Негодная запись останавливает запуск.
FORWARDED_TRUSTED_NETWORKS=

# Публичный адрес системы (напр. https://docs.example.ru) — внешний URL, по которому
# пользователи открывают систему. Подставляется ссылкой в письма: сброс пароля,
# подтверждение/смена email, отправка крупного комплекта (> 15 МБ).
# ВАЖНО: без него письма со ссылками НЕ отправляются (действие вернёт понятную ошибку).
# Обязателен, если пользуетесь самостоятельным сбросом пароля / подтверждением почты.
APP_PUBLIC_URL=

# ── Локальное распознавание сканов (Ollama) ──────────────────────────────────────────────────
# По умолчанию ВЫКЛЮЧЕНО (issue #824): контейнер с моделью — это ~6 ГБ диска и до 10 ГБ памяти,
# а распознавание может идти облачным движком (ключи ниже) либо не использоваться вовсе.
# Нужно локальное, без обращения к внешним сервисам, — раскомментируйте ОБЕ строки и выполните
# `docker compose up -d`: модель скачает сервис ollama-init, это надолго и один раз.
#
# Строк две, потому что и выключателя два, и они про разное: первая решает, поднимать ли
# контейнеры, вторая — пользуется ли Ollama само приложение. Раскомментировать только первую —
# контейнер поднимется вхолостую (об этом скажет `docker compose logs ollama-init`); только
# вторую — приложение будет ждать движок, которого нет, и мониторинг сообщит, что Ollama не
# отвечает. Ни то ни другое не тихо, но лишний круг стоит времени.
#
# Выключить УЖЕ работающую Ollama правкой этих строк нельзя: профиль решает, что поднимать, а не
# что останавливать. Закомментировали — уберите контейнеры явно:
#   docker compose rm -sf ollama ollama-init
# А если настройки интеграций хоть раз сохраняли в интерфейсе, там же и выключите движок:
# сохранённая модель лежит в базе, и база сильнее этой переменной.
#COMPOSE_PROFILES=ollama
#OLLAMA_MODEL=qwen2.5vl:7b

# Каталог резервных копий на хосте (issue #831). Сюда система кладёт снятые копии и отсюда же
# восстанавливается — по сети при этом не идёт ничего, поэтому предел размера этому пути не нужен.
# Это точка монтирования, а не том Docker: по этому пути копию увозят rsync-ом и подкладывают
# копию с другого сервера — переезд делается именно так.
# ВАЖНО: каталог должен принадлежать пользователю app (uid 1654) — контейнер работает не от root.
# Недостающий каталог Docker создаст от root, и сервер откажется стартовать, назвав причину:
#   mkdir -p ./backups && sudo chown 1654:1654 ./backups
BACKUP_DIR=./backups

# Сколько копий держать в каталоге. Достигнут предел — новая копия НЕ создаётся (отказ с
# объяснением и уведомлением), старые сами не удаляются: молчаливое «копия не снялась» хуже
# отказа, а автоудаление однажды унесло бы ту единственную, которая понадобится.
# Допустимо от 1 до 1000; негодное значение останавливает запуск.
BACKUP_KEEP_COUNT=10

# Предел размера копии, ЗАГРУЖАЕМОЙ ЧЕРЕЗ БРАУЗЕР, МБ. С issue #831 это предел одного лишь
# транспорта: копия крупнее переносится файлом в BACKUP_DIR и восстанавливается оттуда без
# ограничений. Этой же переменной задаётся client_max_body_size у веб-сервера — менять что-то ещё
# не нужно. Допустимо от 16 до 10240; негодное значение останавливает запуск.
BACKUP_MAX_ARCHIVE_MB=500

# Потолки памяти контейнеров. Тяжёлые операции запускает пользователь, и без потолка неудачный
# шаблон или большой архив уводят в своп весь хост. Слишком низкое значение выглядит как
# перезапуск контейнера без внятной причины — см. docs/DEPLOYMENT.md §10.
API_MEMORY_LIMIT=3g
# Действует, только когда включён профиль ollama (см. выше).
OLLAMA_MEMORY_LIMIT=10g

# Внешние сервисы (опционально; нужны только для документов качества)
# Anthropic / Gemini — распознавание реквизитов; Serper — веб-поиск документов
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
SERPER_API_KEY=
