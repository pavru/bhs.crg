# syntax=docker/dockerfile:1
# ── Сборка ──────────────────────────────────────────────────────────────────────
ARG DOTNET=10.0
FROM mcr.microsoft.com/dotnet/sdk:${DOTNET} AS build
WORKDIR /src
# Хеш коммита приходит СНАРУЖИ: .git исключён из контекста сборки (.dockerignore), поэтому таргет
# SetGitCommitId в Directory.Build.props внутри контейнера тихо отдал бы пусто — и релизный образ
# сообщал бы `commit: ""` ровно там, где трассировка сборки нужнее всего. Таргет уже написан с
# условием «если SourceRevisionId не задан», так что аргумент его просто перекрывает.
ARG SOURCE_REVISION=""
COPY src/server ./server
RUN dotnet restore server/BHS.CRG.Api/BHS.CRG.Api.csproj
RUN dotnet publish server/BHS.CRG.Api/BHS.CRG.Api.csproj -c Release -o /app --no-restore -p:SourceRevisionId="$SOURCE_REVISION"

# ── Рантайм ─────────────────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/aspnet:${DOTNET} AS runtime

# Typst CLI (генерация PDF) + шрифты (в т.ч. кириллица) + либы для SkiaSharp/PDFium
# 0.15+ нужен для нативной вставки страниц PDF-вложений: image(src, page: n) с текстовым слоем.
# ВНИМАНИЕ: curl здесь не только инструмент установки — на нём держится healthcheck контейнера
# (см. docker-compose.yml, api). Уберёте его «как ненужный после сборки» — healthcheck перестанет
# проходить, а web не поднимется вовсе (он ждёт api по condition: service_healthy), и симптом
# «после обновления сайт не открывается» будет в другом файле, чем причина.
ARG TYPST_VERSION=0.15.0
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates xz-utils \
        libfontconfig1 libfreetype6 \
        fonts-dejavu fonts-liberation fonts-noto-core \
    && curl -fsSL "https://github.com/typst/typst/releases/download/v${TYPST_VERSION}/typst-x86_64-unknown-linux-musl.tar.xz" -o /tmp/typst.tar.xz \
    && tar -xJf /tmp/typst.tar.xz -C /tmp \
    && mv /tmp/typst-x86_64-unknown-linux-musl/typst /usr/local/bin/typst \
    && chmod +x /usr/local/bin/typst \
    && rm -rf /tmp/typst* /var/lib/apt/lists/*

ENV TYPST_PATH=/usr/local/bin/typst \
    ASPNETCORE_URLS=http://+:8080 \
    DOTNET_EnableDiagnostics=0

WORKDIR /app
COPY --from=build /app ./

# Работаем не от root: в образе aspnet непривилегированный пользователь `app` уже заведён.
# Каталог ключей Data Protection создаём здесь и отдаём ему — пустой том Docker при первом
# подключении наследует владельца и права каталога из образа.
# ВНИМАНИЕ при обновлении УЖЕ РАБОТАЮЩЕЙ установки: том dp_keys создавался от root, владелец
# у него не поменяется сам. Разово выполнить (см. docs/DEPLOYMENT.md §8) — обратите внимание на
# --entrypoint: без него аргументы уедут в ENTRYPOINT ниже и вместо chown запустится сам сервер:
#   docker compose -f deploy/docker-compose.yml run --rm --user root --entrypoint chown api -R app:app /app/dp-keys
RUN mkdir -p /app/dp-keys && chown -R app:app /app
USER app

EXPOSE 8080
ENTRYPOINT ["dotnet", "BHS.CRG.Api.dll"]
